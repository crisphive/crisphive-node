{
  "name": "@crisphive/sdk",
  "version": "0.3.0",
  "description": "Official Node.js/TypeScript SDK for the Crisphive API.",
  "author": "CrisphiveDeveloper <developer@crisphive.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisphive/crisphive-node.git"
  },
  "keywords": [
    "axios",
    "typescript",
    "openapi-client",
    "@crisphive/sdk"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "12.11.5 - 12.20.42",
    "typescript": "^4.0 || ^5.0"
  },
  "homepage": "https://docs.crisphive.com",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
